#!/usr/bin/env bash
#
# dot — single entrypoint for these dotfiles.
#
#   ./dot install     everything: prereqs, sync, packages, configure
#   ./dot sync        symlink home/ into $HOME
#   ./dot packages    install packages for this platform
#   ./dot configure   apply configuration (locale, git, shell, vim, macOS defaults)
#   ./dot update      fast-forward the repo to its upstream, then sync
#   ./dot doctor      report what is missing or out of sync
#   ./dot test        lint and run the test suite
#
# No `set -euo pipefail` on purpose: a step that fails should warn and let the
# rest of the run continue. Failures are counted and reported at the end.

# -P, so the root is the canonical path even when the repo is reached through a
# symlink. Without it `~/dotfiles/dot` and `~/code/dotfiles/dot` produce two
# different link targets for the same file, and each run undoes the other's links.
DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=lib/os.sh
source "$DOTFILES_ROOT/lib/os.sh"
# shellcheck source=lib/log.sh
source "$DOTFILES_ROOT/lib/log.sh"
# shellcheck source=lib/link.sh
source "$DOTFILES_ROOT/lib/link.sh"

DRY_RUN=""
ASSUME_YES=""

usage() {
  cat <<'EOF'
Usage: ./dot <command> [options]

Commands:
  install            Full setup: prereqs → sync → packages → configure
  sync               Symlink home/ into $HOME (dotfiles and configs only)
  packages           Install packages: Brewfile on macOS, apt sources + apt.txt on Linux
  configure [step]   Apply configuration; step = locale | git | shell | vim | macos
  update             Fast-forward the repo to its upstream, then sync
  doctor             Health check: links, tools, shell, locale, git identity
  test               Syntax check, shellcheck and the bats suite under test/
  help               Show this help

Options:
  -n, --dry-run      Show what would happen without changing anything
  -y, --yes          Assume yes; never prompt
  -h, --help         Show this help
      --linux        Force the Linux path (overrides platform detection)
      --unlink       sync only: remove the symlinks we created
      --status       sync only: report link state without writing

Examples:
  ./dot install              # first run on a new machine, and after a packages/config change
  ./dot sync                 # after editing anything under home/
  ./dot sync --status        # what drifted?
  ./dot update               # pull the latest commits and re-link
  ./dot configure git        # just re-apply the git config
EOF
}

cmd_sync() {
  local mode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --status|--unlink)
        [ -n "$mode" ] && die "sync: $mode and $1 cannot be combined"
        mode="$1"
        ;;
      *) die "unknown sync option: $1 (--status | --unlink)" ;;
    esac
    shift
  done

  case "$mode" in
    --status) section "Link status"; link_status; return $? ;;
    --unlink) section "Removing dotfile links"; link_unlink; return $? ;;
  esac
  section "Syncing dotfiles"
  link_tree
}

cmd_configure() {
  [ $# -le 1 ] || die "configure takes at most one step (got: $*)"

  # shellcheck source=setup/locale.sh
  source "$DOTFILES_ROOT/setup/locale.sh"
  # shellcheck source=setup/git.sh
  source "$DOTFILES_ROOT/setup/git.sh"
  # shellcheck source=setup/shell.sh
  source "$DOTFILES_ROOT/setup/shell.sh"
  # shellcheck source=setup/vim.sh
  source "$DOTFILES_ROOT/setup/vim.sh"
  # shellcheck source=setup/macos-defaults.sh
  source "$DOTFILES_ROOT/setup/macos-defaults.sh"

  case "$1" in
    locale) setup_locale ;;
    git)    setup_git ;;
    shell)  setup_shell ;;
    vim)    setup_vim ;;
    macos)  setup_macos_defaults ;;
    # Every step runs even if an earlier one failed, but the failure still has to
    # reach the exit code. A bare sequence would return the status of its last
    # command, and `if is_macos; …; fi` is 0 on Linux no matter what setup_git did.
    #
    # locale goes first: it fixes the encoding the rest of the run — and every
    # shell started after it — reads and writes text in.
    "")     local rc=0
            setup_locale || rc=1
            setup_git    || rc=1
            setup_shell  || rc=1
            setup_vim    || rc=1
            # plain `is_macos && …` would make the whole command fail on Linux
            if is_macos; then setup_macos_defaults || rc=1; fi
            return "$rc"
            ;;
    *)      die "unknown configure step: $1 (locale | git | shell | vim | macos)" ;;
  esac
}

cmd_packages() {
  [ $# -eq 0 ] || die "packages takes no options (got: $*)"

  # shellcheck source=setup/packages.sh
  source "$DOTFILES_ROOT/setup/packages.sh"
  setup_packages
}

cmd_install() {
  [ $# -eq 0 ] || die "install takes no options (got: $*)"

  # a step that soft-fails must not make `install` look successful when the same
  # step run on its own (`./dot configure git`) would have exited non-zero
  local rc=0

  printf '%s%sdotfiles — %s%s\n' "$C_BOLD" "$C_BLUE" "$OS" "$C_RESET"
  [ -n "$DRY_RUN" ] && info "dry run: nothing will be modified"

  # before the prereqs step, not after: an existing Homebrew that is merely not
  # on this process's PATH would otherwise look uninstalled and send the step off
  # to run the Homebrew installer over it
  is_macos && brew_shellenv

  # shellcheck source=setup/prereqs.sh
  source "$DOTFILES_ROOT/setup/prereqs.sh"
  # On macOS a failed prereqs step is fatal: without the CLI tools or Homebrew
  # every phase below is the same failure over again. On Linux it only gates
  # `packages` — sync and configure still have work to do, so it just counts.
  if ! setup_prereqs; then
    is_macos && die "prerequisites incomplete"
    rc=1
  fi

  # every phase runs even when an earlier one failed — that is the whole point of
  # not using `set -e` here — but the failure still has to reach the exit code
  cmd_sync      || rc=1
  cmd_packages  || rc=1
  cmd_configure || rc=1

  # the warning/error counts themselves are reported by main, for every command
  section "Done"
  if [ "$LOG_ERRORS" -eq 0 ] && [ "$LOG_WARNINGS" -eq 0 ]; then
    ok "Reload your shell: exec zsh"
  else
    info "Reload your shell once the issues above are sorted: exec zsh"
  fi
  return "$rc"
}

# Fast-forward the checkout to its upstream, then re-link.
#
# `sync` afterwards and nothing else: it is the one phase a new commit can
# invalidate on its own — a file added to or renamed under home/ stays unlinked
# until sync runs, while editing an already-linked file needs nothing. packages
# and configure want sudo and the network, which is more than "update the repo"
# should ever imply; `./dot install` is still there for that.
#
# The git queries below are read-only and deliberately not wrapped in `run` —
# same as the `git config --get` calls in cmd_doctor. Only the two commands that
# write (fetch, merge) go through it, so --dry-run reports against whatever the
# last real fetch left behind and says so.
cmd_update() {
  [ $# -eq 0 ] || die "update takes no options (got: $*)"

  section "Updating the repo"

  # same guard as setup/git.sh and cmd_doctor: without git every query below
  # sprays "command not found" onto stderr, outside the run report
  if ! has git; then
    err "git not installed — run ./dot packages"
    return 1
  fi

  # --show-toplevel, not --git-dir: a checkout dropped inside another repo would
  # answer yes to "is there a git dir above me?" and we would update that one.
  # Both sides are canonical — $DOTFILES_ROOT is built with `pwd -P`.
  local toplevel
  toplevel="$(git -C "$DOTFILES_ROOT" rev-parse --show-toplevel 2>/dev/null)"
  if [ "$toplevel" != "$DOTFILES_ROOT" ]; then
    err "$DOTFILES_ROOT is not the root of a git checkout — nothing to update"
    return 1
  fi

  local upstream
  upstream="$(git -C "$DOTFILES_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"
  if [ -z "$upstream" ]; then
    err "the current branch has no upstream — set one with: git -C $DOTFILES_ROOT branch -u <remote>/<branch>"
    return 1
  fi

  # Local changes are not a reason to refuse. The common case is an edit under
  # home/ while the incoming commits touch setup/, and `merge --ff-only` refuses
  # on its own when the update would overwrite one of them — nothing can be
  # lost. The warning still has to be here, or a refusal below would read as if
  # the remote were at fault.
  if [ -n "$(git -C "$DOTFILES_ROOT" status --porcelain 2>/dev/null)" ]; then
    warn "the repo has uncommitted changes — the update is refused if it would overwrite one"
  fi

  if ! run git -C "$DOTFILES_ROOT" fetch --quiet; then
    err "git fetch failed — is $upstream reachable from here?"
    return 1
  fi

  local behind line
  behind="$(git -C "$DOTFILES_ROOT" rev-list --count "HEAD..$upstream" 2>/dev/null)"
  if [ "${behind:-0}" -eq 0 ]; then
    ok_run "already up to date with $upstream" \
           "already up to date with $upstream (as of the last fetch)"
    return 0
  fi

  info "$behind commit(s) behind $upstream:"
  # no bare echo: the log lines are part of the run report like everything else
  while IFS= read -r line; do
    info "  $line"
  done < <(git -C "$DOTFILES_ROOT" log --oneline --no-decorate "HEAD..$upstream" 2>/dev/null)

  # --quiet: the commits are already listed above, and merge's own diffstat is
  # raw output in the middle of the run report
  if ! run git -C "$DOTFILES_ROOT" merge --quiet --ff-only "$upstream"; then
    err "fast-forward failed — the branch has diverged or a local change is in the way; sort it out in $DOTFILES_ROOT"
    return 1
  fi
  ok_run "fast-forwarded to $upstream" "would fast-forward to $upstream"

  # This process is still running the code it was started with: `dot` and
  # everything under lib/ and setup/ were sourced before the merge above
  # replaced them on disk. That is deliberate and predictable — the new
  # link_tree takes effect on the next invocation, not in the sync below.
  local rc=0
  cmd_sync || rc=1
  return "$rc"
}

# Lint and test, in the order that gives the most useful first failure: a syntax
# error makes every later stage meaningless, and a shellcheck finding is cheaper
# to read than a bats failure caused by it.
#
# Like `doctor`, this owns its exit code — bats output is not the run report, and
# a failing test is not the same thing as a failed configuration step.
cmd_test() {
  [ $# -eq 0 ] || die "test takes no options (got: $*)"

  # test/ci-deps.sh is in here because CI executes it on every job; test/helper.bash
  # deliberately is not — every variable it sets is consumed by the .bats files,
  # which shellcheck cannot see, so it produces nothing but SC2034 noise.
  local scripts=("$DOTFILES_ROOT/dot" "$DOTFILES_ROOT/bootstrap.sh"
                 "$DOTFILES_ROOT/test/ci-deps.sh")
  local f
  for f in "$DOTFILES_ROOT"/lib/*.sh "$DOTFILES_ROOT"/setup/*.sh; do
    scripts+=("$f")
  done

  section "Syntax"
  if bash -n "${scripts[@]}"; then
    ok "${#scripts[@]} scripts parse"
  else
    err "syntax errors — see above"
    return 1
  fi

  section "Shellcheck"
  # not an error when absent: shellcheck is not a prerequisite for using these
  # dotfiles, only for developing them. CI installs it, so the gate still exists.
  if ! has shellcheck; then
    skip "shellcheck not installed — brew install shellcheck / apt-get install shellcheck"
  elif shellcheck -x "${scripts[@]}"; then
    ok "no findings"
  else
    err "shellcheck findings — see above"
    return 1
  fi

  section "Tests"
  if ! has bats; then
    err "bats not installed — brew install bats-core / apt-get install bats"
    return 1
  fi
  # $HOME and $XDG_STATE_HOME are redirected per test by test/helper.bash, so
  # this never touches the real home directory
  bats "$DOTFILES_ROOT"/test/*.bats || return 1
  return 0
}

cmd_doctor() {
  [ $# -eq 0 ] || die "doctor takes no options (got: $*)"

  local issues=0

  # for _locale_wanted / _locale_available below — sourcing a setup file runs
  # nothing, they all define functions and do nothing at source time
  # shellcheck source=setup/locale.sh
  source "$DOTFILES_ROOT/setup/locale.sh"

  # same reason as in cmd_install: an existing Homebrew that is merely not on this
  # process's PATH must not be reported as missing — every brew-installed tool
  # below would follow it into a list of things `./dot packages` cannot fix.
  is_macos && brew_shellenv

  section "Platform"
  info "os:    $OS$(is_wsl && printf ' (WSL)')"
  # the passwd entry, not $SHELL — the latter keeps the old value until re-login
  local login_shell
  login_shell="$(login_shell_path)"
  info "shell: ${login_shell:-unknown}"
  case "$login_shell" in
    *zsh) ok "login shell is zsh" ;;
    # neither getent nor dscl answered — "not zsh" would be a claim we cannot make
    "")   warn "could not determine the login shell"; issues=1 ;;
    *)    warn "login shell is not zsh — run ./dot configure shell"; issues=1 ;;
  esac

  # The LANG home/.exports exports has to exist on this machine, or setlocale()
  # falls back to C: perl warns on every apt run and nothing handles UTF-8
  # correctly. glibc only ships C/C.UTF-8, so on a fresh Linux box this is the
  # normal state until `./dot configure locale` has run. Reported rather than
  # inferred from $LANG — this process may not have sourced .exports at all.
  local want_locale
  want_locale="$(_locale_wanted)"
  if [ -z "$want_locale" ]; then
    :
  elif _locale_available "$want_locale"; then
    ok "locale $want_locale available"
  elif is_linux; then
    warn "locale $want_locale is not generated — run ./dot configure locale"
    issues=1
  else
    warn "locale $want_locale is not available on this system — check home/.exports"
    issues=1
  fi

  section "Links"
  link_status || issues=1

  # link_status covered the link itself; what it cannot see is whether that link
  # is the `dot` $PATH resolves to. ~/.local/bin is *prepended* by home/.exports,
  # so ours normally wins — but graphviz ships a `dot` of its own, and the entry
  # is guarded on the directory existing, so the shell that started this run may
  # predate it. That last case is an info, not a finding: nothing is wrong yet.
  if [ "$(_link_bin_state)" = "linked" ]; then
    local dot_on_path
    dot_on_path="$(command -v dot)"
    if [ -z "$dot_on_path" ]; then
      info "dot is not on this shell's PATH yet — exec zsh"
    elif [ "$dot_on_path" != "$LINK_BIN_DEST" ]; then
      warn "\`dot\` resolves to $dot_on_path, not ~/.local/bin/dot"
      issues=1
    fi
  fi

  section "Tools"
  # a spot check of the things other parts of this repo assume exist, not a
  # mirror of Brewfile/apt.txt — `./dot packages` is the authority on those
  local tool missing="" tools_ok=1
  for tool in zsh git vim tmux curl starship node kubectl helm yq bat hx; do
    has "$tool" || missing="$missing $tool"
  done
  is_macos && { has brew || missing="$missing brew"; }
  # home/.exports sets BROWSER=wslview, and the `open` shim relies on it
  is_wsl && { has wslview || missing="$missing wslview"; }

  if [ -n "$missing" ]; then
    warn "not installed:$missing — run ./dot packages"
    issues=1
    tools_ok=""
  fi
  [ -n "$tools_ok" ] && ok "all expected tools present"

  # `yq` is the one name where the WakeMeOps repo competes with a distro package
  # that carries a different tool: the distro's `yq` is a python wrapper around
  # jq. Nothing pins the two apart — apt just prefers the higher version — so
  # check which one actually landed rather than assume.
  if is_linux && has yq && ! yq --version 2>/dev/null | grep -qE 'mikefarah|version v?4'; then
    warn "yq is not mikefarah's v4 — the distro's python yq shadowed it, check the WakeMeOps repo"
    issues=1
  fi

  if has brew && [ -e "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh" ]; then
    ok "antidote (homebrew keg)"
  elif [ -e "$HOME/.antidote/antidote.zsh" ]; then
    ok "antidote (~/.antidote)"
  else
    warn "antidote not found — zsh plugins will not load"
    issues=1
  fi

  section "Git"
  # The `git config --get` queries below are read-only, but they are not wrapped
  # in `run` and would really execute: without git they spray "command not
  # found" onto stderr — outside the report — and every finding under them would
  # describe a configuration that cannot exist yet. Same guard as setup/git.sh.
  if ! has git; then
    warn "git not installed — run ./dot packages"
    issues=1
  else
    # both halves, the same condition setup_git ends on — testing only the mail
    # would put a ✓ on `  <you@example.com>` with an empty name, for exactly the
    # state `./dot configure git` calls incomplete
    local git_name git_email
    git_name="$(git config --global user.name)"
    git_email="$(git config --global user.email)"
    if [ -n "$git_name" ] && [ -n "$git_email" ]; then
      ok "$git_name <$git_email>"
    else
      warn "git identity incomplete — run ./dot configure git"
      issues=1
    fi
    local helper
    helper="$(git config --global credential.helper)"
    if [ -n "$helper" ]; then
      info "credential.helper: $helper"
    else
      warn "credential.helper not set — run ./dot configure git"
      issues=1
    fi
  fi

  section "Result"
  if [ "$issues" -eq 0 ]; then
    ok "everything looks good"
    return 0
  fi
  warn "issues found — see above"
  return 1
}

main() {
  local command="" args=() status=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) DRY_RUN=1 ;;
      -y|--yes)     ASSUME_YES=1 ;;
      --linux)      export DOTFILES_OS=linux; detect_os ;;
      -h|--help)    usage; return 0 ;;
      -*)           args+=("$1") ;;
      *)            if [ -z "$command" ]; then command="$1"; else args+=("$1"); fi ;;
    esac
    shift
  done

  case "$command" in
    # doctor, test and help report themselves and own their exit code
    doctor)          cmd_doctor "${args[@]}"; return $? ;;
    test)            cmd_test "${args[@]}"; return $? ;;
    # `usage` is the whole job here, but an argument nobody understood must not
    # vanish into it: `./dot --bogus` would otherwise print the help and exit 0,
    # which is exactly what every other command refuses to do.
    help|"")         if [ "${#args[@]}" -gt 0 ]; then
                       err "unrecognised argument(s): ${args[*]}"
                       usage
                       return 1
                     fi
                     usage
                     return 0
                     ;;
    install)         cmd_install "${args[@]}" ;;
    sync)            cmd_sync "${args[@]}" ;;
    packages)        cmd_packages "${args[@]}" ;;
    configure)       cmd_configure "${args[@]}" ;;
    update)          cmd_update "${args[@]}" ;;
    *)               err "unknown command: $command"; usage; return 1 ;;
  esac
  status=$?

  # Nothing aborts on its own (see the note at the top), so the run summary and
  # the exit code are decided here — once, the same way for every command.
  if [ "$LOG_ERRORS" -gt 0 ]; then
    err "$LOG_ERRORS error(s), $LOG_WARNINGS warning(s) — see above"
    return 1
  fi
  [ "$LOG_WARNINGS" -gt 0 ] && warn "$LOG_WARNINGS warning(s) — see above"
  return "$status"
}

# `./dot update` replaces this file while bash is executing it. Bash parses a
# script one command at a time and keeps a file offset, so a bare `main "$@"` as
# the last line leaves it reading from the file once more after main returns —
# and from a *longer* replacement that offset lands mid-line, whose remainder is
# then run as a command.
#
# Today that cannot happen: git writes a new file and renames it over this one,
# so our descriptor still refers to the old, unchanged inode. But "safe as long
# as whatever rewrote us did not do it in place" is not a property to depend on.
# The group is parsed in full before any of it runs and the exit means the file
# is never read again, either way.
{ main "$@"; exit $?; }
