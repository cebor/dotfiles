root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# The `Icon` rule has to keep its two literal carriage returns — macOS names
# folder-icon files `Icon\r`. Trimming them silently kills the rule.
[home/.config/git/ignore]
trim_trailing_whitespace = false
