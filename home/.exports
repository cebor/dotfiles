# GPG - use gpg without suite
export GPG_TTY=$(tty)

# locales
export LANG=en_US.UTF-8

# omz
export DISABLE_AUTO_UPDATE=true

# user-local binaries (starship etc. on Linux)
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# snap binaries on PATH (Linux)
[ -d /snap/bin ] && export PATH="$PATH:/snap/bin"

# WSL: default browser (used by the `open` shim / xdg)
grep -qi microsoft /proc/version 2>/dev/null && export BROWSER=wslview

# default editor - guarded, so machines without helix fall back to the system default
if command -v hx &>/dev/null; then
  export EDITOR=hx
  export VISUAL=hx
  export SYSTEMD_EDITOR=hx
fi
