# cross-platform clipboard shims (defined only when missing, i.e. non-macOS)
if ! command -v pbcopy >/dev/null 2>&1; then
  if command -v win32yank.exe >/dev/null 2>&1; then          # WSL, best CRLF handling
    pbcopy()  { win32yank.exe -i --crlf; }
    pbpaste() { win32yank.exe -o --lf; }
  elif command -v clip.exe >/dev/null 2>&1; then             # WSL fallback
    pbcopy()  { clip.exe; }
    pbpaste() { powershell.exe -NoProfile -Command Get-Clipboard | sed 's/\r$//'; }
  elif command -v wl-copy >/dev/null 2>&1; then              # Wayland
    pbcopy()  { wl-copy; }
    pbpaste() { wl-paste; }
  elif command -v xclip >/dev/null 2>&1; then                # X11
    pbcopy()  { xclip -selection clipboard; }
    pbpaste() { xclip -selection clipboard -o; }
  fi
fi

# cross-platform `open` shim.
#
# Under WSL this deliberately overrides an `open` that already exists: xdg-utils
# ships /usr/bin/open on Debian/Ubuntu, and xdg-open looks for a *Linux*
# application, while wslview hands the file to Windows. A `! command -v open`
# guard would find that /usr/bin/open and leave the wslview branch dead.
# Everywhere else the shim only steps in when there is no `open` at all.
if [[ -r /proc/version && "$(</proc/version)" == *[Mm]icrosoft* ]] &&
   command -v wslview >/dev/null 2>&1; then                  # WSL: opens Windows default app
  open() { wslview "$@"; }
elif ! command -v open >/dev/null 2>&1 && command -v xdg-open >/dev/null 2>&1; then
  open() { xdg-open "$@"; }
fi

# find shorthand
f () {
  find . -name "$1"
}

# Start an HTTP server from a directory, optionally specifying the port
server () {
  local port="${1:-8000}"
  (sleep 2 && open "http://localhost:${port}") & disown
  python3 -m http.server "${port}"
}

# Upload file to server and copy link to clipboard.
# The remote name is the *basename*: `scp out/report.pdf host:dir` lands at
# dir/report.pdf, so passing $1 on to chmod and the URL would name a path that
# is not there — silently, with a 404 in the clipboard.
scpp () {
  local host="stkn.org"
  local dir="htdocs/static.stkn.org"
  local name="${1##*/}"

  scp "$1" "$host:$dir" || return 1
  ssh "$host" chmod a+r "$dir/$name" || return 1
  echo "https://static.stkn.org/$name" | pbcopy
  echo "Copied to clipboard: https://static.stkn.org/$name"
}

# npm bump
bump () {
  npm version "$1" -m "bump version to %s"
}

# docker clean
dcl () {
  docker kill $(docker ps -q)
  docker rm $(docker ps -a -q)
}

# ssh tunnel: tunnel <host> <destination port> <local port>
tunnel () {
  echo "Forwarding $1:$2 to localhost:$3"
  ssh -nNT -L "$3":localhost:"$2" "$1"
}

# generate password
pwgen () {
  length=${1:-16}
  openssl rand -base64 $length | tr -d '\n' | colrm $((++length))
}

# source python venv - walks up tree to find and activate virtual environment
svenv () {
  # Deactivate current venv if active
  if [ -n "$VIRTUAL_ENV" ]; then
    deactivate 2>/dev/null
  fi

  CURRENT_DIR="$(pwd)"
  FOUND=0

  while [ "$(pwd)" != "/" ]; do
    # Check for standard venv
    if [ -f "venv/bin/activate" ]; then
      source "venv/bin/activate"
      FOUND=1
      break
    elif [ -f ".venv/bin/activate" ]; then
      source ".venv/bin/activate"
      FOUND=1
      break
    else
      cd ..
    fi
  done

  cd "$CURRENT_DIR"

  if [ $FOUND -eq 1 ]; then
    echo "✓ Activated virtual environment: $VIRTUAL_ENV"
  else
    echo "✗ No virtual environment found"
    return 1
  fi
}
